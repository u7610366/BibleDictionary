#指定したタイトルから次の '###' が来るまでの文章を抽出する関数
def extract_section(file_path, target_title):
    extracted_lines = []
    is_capturing = False

    # 入力に '###' が含まれていない場合は自動で付与する（例: "Genesis" -> "### Genesis"）
    if not target_title.startswith('###'):
        target_title = f"### {target_title}"

    try:
        with open(file_path, 'r', encoding='UTF-8') as f:
            for line in f:
                stripped = line.strip()

                # タイトルに一致したらキャプチャ開始
                if stripped == target_title:
                    is_capturing = True
                    continue

                # 次の別の "###" が来たら終了
                if is_capturing and stripped.startswith('###'):
                    break

                # キャプチャ中なら行をリストに追加
                if is_capturing:
                    extracted_lines.append(line)

        return ''.join(extracted_lines)

    except FileNotFoundError:
        print(f"エラー: スクリプトファイルが見つかりません -> {file_path}", file=sys.stderr)
        return ""

def main():
    # スクリプトの位置を起点にしてテキストファイルのパスを構築
    script_dir = Path(__file__).resolve().parent
    file_path = script_dir / 'script' / 'Old_treatment_BSB.txt'
    help_path = script_dir/'script'/'help'

    # 標準入力（sys.stdin）からパイプ経由の文字列を1行ずつ受け取る
    for line in sys.stdin:
        query = line.strip()
        if not query:
            continue

        # テキスト抽出関数を実行
        result = extract_section(file_path, query)

        if result:
            print(result.strip())
        else:
            print(f"警告: '{query}' に一致する文書が見つかりませんでした。", file=sys.stderr)

if __name__ == '__main__':
    main()
