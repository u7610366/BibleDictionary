script_dir = Path(__file__).resolve().parent
#print(script_dir)

#Old_treatment_BSB.txtのパスを作成
Oldtreatment_path = script_dir/'script'/'Old_treatment_BSB.txt'
#print(file_path)

#helpのパスを作成
help_path = script_dir/'script'/'help'

credit_line = 4

start_line = 1 + credit_line
